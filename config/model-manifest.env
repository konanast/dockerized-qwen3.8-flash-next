        UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf
        UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf
        UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf
      )
      TARGET_SIZES=(10946624 49835229856 43836407744)
      TARGET_SHA256S=(
        5ce89370720f8bf90890f439361282104c1aa1482d4013bb9a50923e758e71a4
        577a38a2392b40ca2193cea502e1d92f60b8cd370675d308e0ec21885d9daaa7
        d4634e6d84f0ebb0940be15c90d3790bf6464e3dea3a1cddc567dc0e83ad8833
      )
      ;;
    UD-Q4_K_XL)
      TARGET_QUANT=UD-Q4_K_XL
      TARGET_DIR=Qwen3.8-Flash-Next-UD-Q4_K_XL
      TARGET_FILES=(
        UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
        UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00002-of-00004.gguf
