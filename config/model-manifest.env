# Populate the selected target variables and arrays. UD-IQ4_XS remains the
# default; MODEL_QUANT may select the larger UD-Q4_K_XL alternative.
select_target_quant() {
  case "${MODEL_QUANT:-UD-IQ4_XS}" in
    UD-IQ4_XS)
      TARGET_QUANT=UD-IQ4_XS
      TARGET_DIR=Qwen3.8-Flash-Next-UD-IQ4_XS
