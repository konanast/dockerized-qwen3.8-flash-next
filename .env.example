# Copy this file to .env. Models and cache are ordinary host directories relative
# to this project, so they remain easy to inspect, back up, and reuse.
MODEL_DIR=./models
HF_CACHE_DIR=./cache/huggingface

# Files downloaded by the root setup container are handed back to this host UID
# and GID. The usual first Ubuntu user is 1000:1000; verify with: id -u; id -g
MODEL_OWNER_UID=1000
MODEL_OWNER_GID=1000

# Keeping DOWNLOAD_MODEL=true is explicit approval for the first start to
# download the selected quantization into MODEL_DIR.
DOWNLOAD_MODEL=true
VERIFY_DOWNLOADS=true

# Default: 91.1 GiB including MTP. Alternative: UD-Q4_K_XL, 107.5 GiB
# including the same MTP sidecar. Downloaded variants remain side-by-side.
MODEL_QUANT=UD-IQ4_XS

# Optional image understanding. When enabled, setup downloads the pinned F16
# multimodal projector (862.1 MiB) and the API loads it with GPU offload.
# Expect roughly 1-2 GiB of additional unified-memory use while processing a
# typical single image; large or multiple images can require more.
ENABLE_VISION=false

# API exposure. 127.0.0.1 is the safe default for a headless host. Run
# ./scripts/init-env.sh to create .env and replace this public placeholder with
# a random 256-bit key. The server refuses to start with the placeholder.
BIND_ADDRESS=127.0.0.1
API_PORT=8080
API_KEY=replace-with-a-long-random-secret
MODEL_ALIAS=qwen3.8-flash-next

# Ubuntu defaults are usually 44 (video) and 109 (render). Verify with:
# getent group video; getent group render
VIDEO_GID=44
RENDER_GID=109

# Memory-conscious defaults for a 128 GiB Strix Halo. Increase CONTEXT_SIZE only
# after checking free memory. EngramHalo+MTP is validated up to 163840 tokens.
PERFORMANCE_PROFILE=balanced
CONTEXT_SIZE=65536
# Used only when PERFORMANCE_PROFILE=dedicated. EngramHalo's published fastest
# interactive RAM-mode profile uses 32768 tokens.
DEDICATED_CONTEXT_SIZE=32768
BATCH_SIZE=8192
UBATCH_SIZE=2048
CPU_THREADS=4
PARALLEL_SLOTS=1

# The defaults below match the measured EngramHalo ROCm/HIP profile.
KV_CACHE_TYPE=q8_0
GPU_LAYERS=999
SPEC_DRAFT_N_MAX=4
SPEC_DRAFT_P_MIN=0.75

# Optional Hugging Face token for rate-limited/private access. Keep it only in
# .env; public downloads normally work without it.
HF_TOKEN=

# Reproducible image/source pins.
IMAGE_TAG=2026-09-16-quant-select
ENGRAMHALO_REF=15176583b358d791b7a73f210ef4ab9e167cfba7
